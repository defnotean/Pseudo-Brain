{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irene.local/schemas/branch.schema.json",
  "title": "Pseudo-Brain counterfactual branch record",
  "description": "Training supervision only; a branch record is never a model observation.",
  "x-irene-visibility": "privileged-target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "branch_group_id",
    "root_snapshot_hash",
    "root_lifetime_id",
    "root_step",
    "branch_id",
    "rng_state_hash",
    "forced_control_sequence",
    "continuation_policy_id",
    "horizon_ticks",
    "future_frames_ref",
    "state_delta_ref",
    "events",
    "return",
    "replay_exact"
  ],
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys_down",
        "mouse_dx",
        "mouse_dy",
        "mouse_buttons",
        "mouse_wheel",
        "gamepad_axes",
        "gamepad_buttons",
        "impulse_sequence",
        "intended_hold_ns"
      ],
      "properties": {
        "keys_down": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 256,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "mouse_dx": { "type": "number" },
        "mouse_dy": { "type": "number" },
        "mouse_buttons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": { "type": "integer", "minimum": 0, "maximum": 7 }
        },
        "mouse_wheel": { "type": "number" },
        "gamepad_axes": {
          "type": "array",
          "maxItems": 8,
          "oneOf": [
            { "maxItems": 0 },
            { "minItems": 8 }
          ],
          "items": { "type": "number", "minimum": -1, "maximum": 1 }
        },
        "gamepad_buttons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "integer", "minimum": 0, "maximum": 31 }
        },
        "impulse_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "intended_hold_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              { "properties": { "mouse_dx": { "not": { "const": 0 } } } },
              { "properties": { "mouse_dy": { "not": { "const": 0 } } } },
              { "properties": { "mouse_wheel": { "not": { "const": 0 } } } }
            ]
          },
          "then": {
            "properties": {
              "impulse_sequence": { "minimum": 1 }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "branch_group_id": { "type": "string", "minLength": 1 },
    "root_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_lifetime_id": { "type": "string", "minLength": 1 },
    "root_step": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "branch_id": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "rng_state_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "forced_control_sequence": {
      "type": "array",
      "items": { "$ref": "#/$defs/control" }
    },
    "continuation_policy_id": { "type": "string", "minLength": 1 },
    "horizon_ticks": { "type": "integer", "minimum": 1, "maximum": 18446744073709551615 },
    "future_frames_ref": { "type": "string", "minLength": 1 },
    "state_delta_ref": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "return": { "type": "number" },
    "replay_exact": { "type": "boolean" },
    "metadata": {
      "type": "object",
      "description": "Explicit namespace for forward-compatible annotations."
    }
  }
}
