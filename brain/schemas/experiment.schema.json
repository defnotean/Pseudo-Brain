{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://irene.local/schemas/experiment.schema.json",
  "title": "Pseudo-Brain experiment manifest",
  "description": "Immutable identity, execution policy, provenance, and metrics for one experiment run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "schema_version",
    "created_at",
    "code_hash",
    "data_hash",
    "environment_hash",
    "checkpoint_hash",
    "seed",
    "config_hash",
    "hardware",
    "runtime",
    "precision",
    "allow_gpu",
    "allow_capture",
    "allow_hid_output",
    "allow_background_threads",
    "allow_network",
    "allow_subprocess",
    "allow_artifact_write",
    "cpu_threads",
    "status",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "code_hash": {
      "$ref": "#/$defs/sha256"
    },
    "data_hash": {
      "$ref": "#/$defs/sha256"
    },
    "environment_hash": {
      "$ref": "#/$defs/sha256"
    },
    "checkpoint_hash": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "config_hash": {
      "$ref": "#/$defs/sha256"
    },
    "hardware": {
      "$ref": "#/$defs/metadata"
    },
    "runtime": {
      "$ref": "#/$defs/metadata"
    },
    "precision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.:/-]{0,63}$"
    },
    "allow_gpu": {
      "type": "boolean"
    },
    "allow_capture": {
      "type": "boolean"
    },
    "allow_hid_output": {
      "type": "boolean"
    },
    "allow_background_threads": {
      "type": "boolean"
    },
    "allow_network": {
      "type": "boolean"
    },
    "allow_subprocess": {
      "type": "boolean"
    },
    "allow_artifact_write": {
      "type": "boolean"
    },
    "cpu_threads": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "pending",
        "running",
        "completed",
        "failed",
        "aborted",
        "cancelled"
      ]
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  }
}
